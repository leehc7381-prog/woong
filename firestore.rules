rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 코드(추측하기 어려운 무작위 문자열)를 아는 사람만 그 가족의 꿀팁을 읽고 쓸 수 있어요.
    match /families/{code} {
      allow get, create, update: if request.auth != null && code.matches('yw-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}');
      allow list, delete: if false;
      match /{col}/{doc} {
        allow read, write: if request.auth != null && (col == 'tips' || col == 'categories');
      }
    }
  }
}
